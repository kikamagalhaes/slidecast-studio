# SlideCast Web — copie para .env e preencha. SEM chaves de IA (produto sem IA).
# Nenhum valor real de segredo vai neste arquivo.
APP_DOMAIN=slidecast.example.com
# Exigido em produção para rotas admin (header X-Admin-Token). Vazio = sem admin.
ADMIN_TOKEN=
# --- Limites explícitos ---
MAX_CONCURRENT_RENDERS=1
FFMPEG_THREADS=2
MAX_UPLOAD_MB=200
MAX_AUDIO_SECONDS=3600
HEALTH_MIN_DISK_MB=500
JOB_RETENTION_HOURS=24
JOB_RESULT_TTL_HOURS=24
RQ_JOB_TIMEOUT=3600
RATE_LIMIT_PER_MINUTE=120
# --- Fila / servidor ---
QUEUE_BACKEND=redis
REDIS_URL=redis://redis:6379/0
UVICORN_WORKERS=1
PORT=8000
PROXY_HEADERS=1
FORWARDED_ALLOW_IPS=*
LOG_LEVEL=INFO
TZ=America/Sao_Paulo
# --- Contas (sem IA) ---
TRIAL_DAYS=14
PLAN_MONTHLY_RENDERS=30
SESSION_DAYS=30
SESSION_COOKIE_SECURE=1
SLIDECAST_DB_PATH=
# --- Stripe (opcional; sem valores checkout/portal respondem 503) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
