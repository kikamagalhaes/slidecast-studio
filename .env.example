# SlideCast Web - Environment Variables (see README for details)
APP_DOMAIN=slidecast-179-199-133-126.sslip.io
GEMINI_API_KEY=
# Required in production: POST /api/config/key demands this value in the
# X-Admin-Token header. Leave empty only for single-user local runs.
ADMIN_TOKEN=
# Per-file upload cap in megabytes.
MAX_UPLOAD_MB=500

# --- Queue backend: "memory" (single worker) or "redis" (scaled) ---
QUEUE_BACKEND=redis
REDIS_URL=redis://redis:6379/0
# Finished in-memory jobs are evicted after this many hours (memory backend).
JOB_RETENTION_HOURS=24
# Finished Redis jobs expire after this many hours (redis backend).
JOB_RESULT_TTL_HOURS=24
# Hard per-job render timeout in seconds for RQ workers.
RQ_JOB_TIMEOUT=3600

# --- HTTP server (see entrypoint.sh) ---
UVICORN_WORKERS=2
PORT=8000
# Trust X-Forwarded-* headers (set: behind Traefik/Nginx).
PROXY_HEADERS=1
FORWARDED_ALLOW_IPS=*

# --- API abuse protection (in-process, per uvicorn worker) ---
RATE_LIMIT_ENABLED=1
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_WINDOW_SECONDS=60

# --- Health / AI / capture tuning ---
HEALTH_MIN_DISK_MB=500
# Comma-separated Gemini model preference order (first = preferred).
GEMINI_MODELS=
# Neural TTS time budget in seconds.
EDGE_TTS_TIMEOUT=180
# Force specific capture devices (desktop recording).
SLIDECAST_PULSE_SOURCE=
SLIDECAST_DSHOW_AUDIO=

# Logging verbosity: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
TZ=America/Sao_Paulo

# --- SaaS accounts & single plan ---
# Free trial length in days from registration (0 = no trial).
TRIAL_DAYS=14
# Monthly renders included per account (0 = unlimited).
PLAN_MONTHLY_RENDERS=30
# Login session lifetime in days.
SESSION_DAYS=30
# Secure flag on the session cookie (set 0 only for plain-http local dev).
SESSION_COOKIE_SECURE=1
# Override DB location (default: storage/slidecast.db).
SLIDECAST_DB_PATH=

# --- Stripe billing (single recurring plan) ---
# Without these, checkout/portal answer 503 and trials still work.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
